; Engine configuration file.
; "Pursuit: The Journey" — main local game (Godot 4.7)

config_version=5

[application]

config/name="Pursuit: The Journey"
run/main_scene="res://Main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameAudio="*res://game/GameAudio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/min_width=800
window/size/min_height=600
window/stretch/mode="canvas_items"

[rendering]

anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.043, 0.063, 0.188, 1)
